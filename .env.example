# El backend lee este archivo una vez copiado a .env en la raíz.
# Rutas SQLite relativas se resuelven desde backend/, incluso al iniciar desde otra carpeta.
DATABASE_URL=sqlite+aiosqlite:///./data/dashboard.db
FRONTEND_URL=http://localhost:3000
APP_ENV=development

# Autenticación (FASE 2). Genera un valor propio; nunca reutilices el ejemplo.
# openssl rand -hex 32
JWT_SECRET_KEY=change-me-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie de sesión. Secure se activa solo cuando APP_ENV=production.
SESSION_COOKIE_NAME=dashboard_builder_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
# SESSION_COOKIE_DOMAIN=
